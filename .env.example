# Copie ce fichier en « .env.local » pour tester sur ton ordinateur (facultatif).
# Sur Vercel, ces valeurs se saisissent dans Settings > Environment Variables.

# Visibles par le navigateur (normal : elles ne donnent accès qu'aux données autorisées par les règles de la base)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...cle-publique...

# Secrètes : uniquement côté serveur, jamais dans le code
SUPABASE_SERVICE_ROLE_KEY=eyJ...cle-secrete...
ADMIN_USERNAME=m.bournicon
ADMIN_PASSWORD=change-moi
